    npx:hasSignature "bfNm65veYZUHb6hOll678SC3PZwmHvu4zPDV9h2GrYlP6Y0M5XyDBezrSPvaUEe39oTEpc+KEFE1OkCCXcEjmZhD1EjgN66vDcq9wZecQMxWwyHnRm8KhvDhX3L5jTQfYPDlJtG1MmON/3i4bSQ/RxCl09I1ydB4LU3HhhHN2nI=";
    npx:hasSignatureTarget this:;
    npx:signedBy orcid:0000-0002-1267-0234 .
}
