@prefix orcid: <https://orcid.org/> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix pk: <https://w3id.org/probknow/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  rdfs:label rdfs:label "has the label" .
  
  sub:assertion a nt:PubinfoTemplate;
    dct:description "Records the frontier-science domain (e.g. levin-lab, active-inference) a ProbKnow nanopublication belongs to, as a pkr:domain/<slug> IRI.";
    dct:isVersionOf sub:domainKind;
    rdfs:label "ProbKnow domain";
    gen:governedBy <https://w3id.org/spaces/probknow>;
    nt:hasStatement sub:st1, sub:st2 .
  
  sub:domain a nt:ExternalUriPlaceholder;
    rdfs:label "the domain";
    nt:hasPrefix "https://w3id.org/probknow/resource/domain/";
    nt:hasPrefixLabel "pkr:domain/" .
  
  sub:domainLabel a nt:LiteralPlaceholder;
    rdfs:label "the domain's name (its slug)" .
  
  sub:st1 rdf:object sub:domain;
    rdf:predicate pk:domain;
    rdf:subject nt:NANOPUB;
    nt:statementOrder "1" .
  
  sub:st2 a nt:OptionalStatement;
    rdf:object sub:domainLabel;
    rdf:predicate rdfs:label;
    rdf:subject sub:domain;
    nt:statementOrder "2" .
  
  pk:domain rdfs:label "belongs to the domain" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

sub:pubinfo {
  orcid:0000-0002-1267-0234 foaf:name "Tobias Kuhn" .
  
  this: dct:created "2026-10-01T06:55:28Z"^^xsd:dateTime;
    dct:creator orcid:0000-0002-1267-0234;
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    npx:embeds sub:assertion;
    npx:introduces sub:domainKind;
    rdfs:label "ProbKnow domain";
    nt:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA7lSq6MuK_TIC6JMSHvLtee3lpLoZDOqLJCLXevnrPoU>;
