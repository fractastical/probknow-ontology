@prefix this: <https://w3id.org/np/RAIVOEuhWNK4BuCbL_XRChRVlV6LKpFicBzwHpmuRxHWI> .
@prefix sub: <https://w3id.org/np/RAIVOEuhWNK4BuCbL_XRChRVlV6LKpFicBzwHpmuRxHWI/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix pk: <https://w3id.org/probknow/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  dct:description rdfs:label "has the description" .
  
  rdf:type rdfs:label "is a" .
  
  rdfs:label rdfs:label "has the label" .
  
  prov:wasSupportedBy rdfs:label "is supported by" .
  
  sub:assessment a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "an assessment of the claim";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=https://w3id.org/probknow/ontology/Assessment" .
  
  sub:context a nt:LongLiteralPlaceholder;
    rdfs:label "experimental context (organism, intervention, measured quantity, time points)" .
  
  sub:description a nt:LongLiteralPlaceholder;
    rdfs:label "a longer statement of the claim" .
  
  sub:evidence a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "an evidence item supporting the claim";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=https://w3id.org/probknow/ontology/EvidenceItem" .
  
  sub:label a nt:LiteralPlaceholder;
    rdfs:label "the claim in one sentence" .
  
  sub:paper a nt:ExternalUriPlaceholder;
    rdfs:label "the paper the claim was extracted from (DOI as https://doi.org/… IRI)";
    nt:hasPrefix "https://doi.org/";
    nt:hasPrefixLabel "DOI" .
  
  sub:st01 rdf:object pk:Claim;
    rdf:predicate rdf:type;
    rdf:subject <https://w3id.org/probknow/resource/claim/~~ARTIFACTCODE~~>;
    nt:statementOrder "1" .
  
  sub:st02 rdf:object sub:label;
    rdf:predicate rdfs:label;
    rdf:subject <https://w3id.org/probknow/resource/claim/~~ARTIFACTCODE~~>;
    nt:statementOrder "2" .
  
  sub:st03 a nt:OptionalStatement;
    rdf:object sub:description;
    rdf:predicate dct:description;
    rdf:subject <https://w3id.org/probknow/resource/claim/~~ARTIFACTCODE~~>;
    nt:statementOrder "3" .
  
  sub:st04 a nt:OptionalStatement;
    rdf:object sub:context;
    rdf:predicate pk:context;
    rdf:subject <https://w3id.org/probknow/resource/claim/~~ARTIFACTCODE~~>;
    nt:statementOrder "4" .
  
  sub:st05 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:paper;
    rdf:predicate pk:derivedFromPaper;
    rdf:subject <https://w3id.org/probknow/resource/claim/~~ARTIFACTCODE~~>;
    nt:statementOrder "5" .
  
  sub:st06 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:evidence;
    rdf:predicate prov:wasSupportedBy;
    rdf:subject <https://w3id.org/probknow/resource/claim/~~ARTIFACTCODE~~>;
    nt:statementOrder "6" .
  
  sub:st07 a nt:OptionalStatement, nt:RepeatableStatement;
    rdf:object sub:assessment;
    rdf:predicate pk:hasAssessment;
    rdf:subject <https://w3id.org/probknow/resource/claim/~~ARTIFACTCODE~~>;
    nt:statementOrder "7" .
  
  sub:st08 a nt:OptionalStatement;
    rdf:object sub:weight;
    rdf:predicate pk:weightOfEvidence;
    rdf:subject <https://w3id.org/probknow/resource/claim/~~ARTIFACTCODE~~>;
    nt:statementOrder "8" .
  
  sub:template a nt:AssertionTemplate;
    dct:description "A discrete scientific claim extracted from a paper by the ProbKnow pipeline, with its experimental context, the evidence items supporting it, the assessments made of it, and the panel-assigned weight of evidence (a score from 0 to 1). The claim is a belief, not an asserted fact; its credibility is carried by the weight and the assessments. The claim's identifier is minted from this nanopublication's artifact code.";
    dct:isVersionOf <https://w3id.org/np/RACSW-97Ldd_hknVOLd2FEB6b8KwgRlp1DdlhR3uFGtt0/claimKind>;
    rdfs:label "ProbKnow claim";
    gen:governedBy <https://w3id.org/spaces/probknow>;
    nt:hasNanopubLabelPattern "${label}";
    nt:hasStatement sub:st01, sub:st02, sub:st03, sub:st04, sub:st05, sub:st06, sub:st07,
      sub:st08;
    nt:hasTag "ProbKnow";
    nt:hasTargetNanopubType pk:Claim .
  
  sub:weight a nt:LiteralPlaceholder;
    rdfs:label "panel-assigned weight of evidence, from 0 to 1";
    nt:hasDatatype xsd:double;
    nt:hasRegex "^(0(\\.[0-9]+)?|1(\\.0+)?)$" .
  
  pk:Claim rdfs:label "claim" .
  
  pk:context rdfs:label "has the experimental context" .
  
  pk:derivedFromPaper rdfs:label "is derived from the paper" .
  
  pk:hasAssessment rdfs:label "has the assessment" .
  
  pk:weightOfEvidence rdfs:label "has the weight of evidence (0–1)" .
  
  <https://w3id.org/probknow/resource/claim/~~ARTIFACTCODE~~> a nt:IntroducedResource;
    rdfs:label "this claim" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

sub:pubinfo {
  orcid:0000-0002-1267-0234 foaf:name "Tobias Kuhn" .
  
  this: dct:created "2026-10-01T07:30:41Z"^^xsd:dateTime;
