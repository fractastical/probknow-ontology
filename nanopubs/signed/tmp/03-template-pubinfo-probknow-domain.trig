@prefix this: <http://purl.org/nanopub/temp/np001/> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix orcid: <https://orcid.org/> .
@prefix pk: <https://w3id.org/probknow/ontology/> .
@prefix pkr: <https://w3id.org/probknow/resource/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  pk:domain rdfs:label "belongs to the domain" .
  rdfs:label rdfs:label "has the label" .

  sub:domain a nt:ExternalUriPlaceholder ;
    rdfs:label "the domain" ;
    nt:hasPrefix "https://w3id.org/probknow/resource/domain/" ;
    nt:hasPrefixLabel "pkr:domain/" .

  sub:domainLabel a nt:LiteralPlaceholder ;
    rdfs:label "the domain's name (its slug)" .

  sub:st1 rdf:subject nt:NANOPUB ;
    rdf:predicate pk:domain ;
    rdf:object sub:domain ;
    nt:statementOrder "1" .

  sub:st2 a nt:OptionalStatement ;
    rdf:subject sub:domain ;
    rdf:predicate rdfs:label ;
    rdf:object sub:domainLabel ;
    nt:statementOrder "2" .

  sub:assertion a nt:PubinfoTemplate ;
    rdfs:label "ProbKnow domain" ;
    dct:description "Records the frontier-science domain (e.g. levin-lab, active-inference) a ProbKnow nanopublication belongs to, as a pkr:domain/<slug> IRI." ;
    dct:isVersionOf sub:domainKind ;
    gen:governedBy <https://w3id.org/spaces/probknow> ;
    nt:hasStatement sub:st1, sub:st2 .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://orcid.org/0000-0002-1267-0234> .
}

sub:pubinfo {
  orcid:0000-0002-1267-0234 foaf:name "Tobias Kuhn" .

  this: dct:created "2026-10-01T06:55:28Z"^^xsd:dateTime ;
    dct:creator orcid:0000-0002-1267-0234 ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:label "ProbKnow domain" ;
    npx:embeds sub:assertion ;
    npx:introduces sub:domainKind ;
    nt:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA7lSq6MuK_TIC6JMSHvLtee3lpLoZDOqLJCLXevnrPoU> ;
    nt:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RAukAcWHRDlkqxk7H2XNSegc1WnHI569INvNr-xdptDGI>, <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8> ;
    nt:wasCreatedFromTemplate <https://w3id.org/np/RA3KyKGBWWXKZa-Tgq1XW8djl-9veFZDC2lcXIOeNz1WE> .
}
