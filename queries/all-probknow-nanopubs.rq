# All nanopublications that use any ProbKnow ontology term or resource
# (current slash terms, version-1.0 hash terms, or pkr: resources).
# Run against the nanopub network SPARQL endpoint, e.g.
#   https://query.knowledgepixels.com/repo/full  (or virtuoso.nps.petapico.org/sparql)
PREFIX pk: <https://w3id.org/probknow/ontology/>
PREFIX pkr: <https://w3id.org/probknow/resource/>
PREFIX np: <http://www.nanopub.org/nschema#>

SELECT DISTINCT ?np WHERE {
  GRAPH ?head { ?np a np:Nanopublication ; np:hasAssertion ?a . }
  GRAPH ?a { ?s ?p ?o . }
  FILTER(STRSTARTS(STR(?p), STR(pk:)) || STRSTARTS(STR(?s), STR(pkr:)) || (isIRI(?o) && STRSTARTS(STR(?o), STR(pk:))))
}
LIMIT 200
